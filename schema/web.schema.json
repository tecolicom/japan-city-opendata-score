{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecolicom/japan-public-data-index/main/schema/web.schema.json",
  "title": "自治体の web 基盤 (municipalities/<pref>/<handle>/web.yaml)",
  "description": "指紋照合の結果。family が特定できなかったときも『照合した』事実は残す (family_id: null)。",
  "type": "object",
  "required": [
    "handle",
    "url",
    "family_id",
    "family_confidence",
    "signals_seen",
    "fingerprinted_at"
  ],
  "additionalProperties": false,
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "url": {
      "description": "指紋採取に実際に使ったトップページの URL (観測値)。レジストリの website と同じならそのまま、違うなら registry_website と url_note が要る。",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "registry_website": {
      "description": "url がレジストリの website と異なるときだけ書く。レジストリが言っていた値 (出典データの古さの記録)。レジストリは手で直さない。",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "url_note": {
      "description": "レジストリの website から外れた根拠。推測ではなく観測に基づく代替であること。",
      "type": "object",
      "required": [
        "observed_at",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "family_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^fam-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "family_confidence": {
      "description": "導出値。signals_seen と family の min_signals から thresholdBasis (scripts/_lib/family-check.mjs) と同じ規則で決まる。observed=観測だけで閾値を満たす / inferred=推定を足して初めて満たす / below=どの family の閾値にも届かないが痕跡は 1 本以上ある (family_id が null でも、family_id があって届かない場合も) / none=痕跡がゼロ (family_id: null)。手で判断して書く値ではない。",
      "enum": [
        "observed",
        "inferred",
        "below",
        "none"
      ]
    },
    "fingerprinted_at": {
      "type": "string",
      "format": "date"
    },
    "signals_seen": {
      "description": "その自治体で実際に確認した signal (family の measured_representatives.signals_seen と同形)。family_id が null でも、既知 family の signal に 1 本でも当たったなら記録する (まだ同定できていない family の候補群という情報を捨てない)。何も当たらなければ空。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "signal",
          "method"
        ],
        "additionalProperties": false,
        "properties": {
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "html",
              "header",
              "asset_fetch",
              "inferred_from_status"
            ]
          }
        }
      }
    },
    "family_divergence": {
      "description": "この handle が family の measured_representatives に載っているのに、自動指紋が family_id を特定できなかった/別の family だったときの説明。測っているものの違い (自動指紋はトップ HTML のみ、等) を書く。食い違いを黙って並べないための必須項目。",
      "type": "object",
      "required": [
        "observed_at",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "family_id": {
            "type": "null"
          }
        },
        "required": [
          "family_id"
        ]
      },
      "then": {
        "properties": {
          "family_confidence": {
            "enum": [
              "none",
              "below"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "family_confidence": {
            "enum": [
              "observed",
              "inferred",
              "below"
            ]
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "registry_website": [
      "url_note"
    ],
    "url_note": [
      "registry_website"
    ]
  }
}

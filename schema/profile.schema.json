{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/japan-public-data-index/profile.schema.json",
  "title": "領域プロファイル (段階表とキャップ規則)",
  "description": "schema/profiles/<name>.yaml。axes は観測事実 → 点数の段階表 (applyProfile が使う)。caps は合計後に掛ける上限 (score が使う)。条件の語彙は領域ごとに決める。コア配点の上限超過は scripts/score.mjs の checkProfile が検査する。",
  "type": "object",
  "required": ["profile", "revision", "axes"],
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "ファイル名と一致させる。" },
    "revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$", "description": "段階表の版 (改訂日.連番。例 2026-10-24.1)。assessment の profile_revision がこれを指し、validate が一致を検査する。段を変えたら必ず上げる。" },
    "axis_aliases": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "G": { "const": "g_proxy", "description": "G は単発訪問の代理指標版 (docs/index.md §7)。時系列版と取り違えないよう、G 軸を持つ段階表は g_proxy の別名を宣言する。" } }
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/$defs/steps" }, "B": { "$ref": "#/$defs/steps" }, "C": { "$ref": "#/$defs/steps" },
        "D": { "$ref": "#/$defs/steps" }, "E": { "$ref": "#/$defs/steps" }, "F": { "$ref": "#/$defs/steps" }, "G": { "$ref": "#/$defs/steps" }
      }
    },
    "caps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "max"],
        "additionalProperties": false,
        "properties": {
          "when": { "$ref": "#/$defs/when" },
          "max": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  },
  "$defs": {
    "when": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          { "type": "string" }, { "type": "number" }, { "type": "boolean" },
          { "type": "array", "minItems": 1, "items": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["when", "points"],
        "additionalProperties": false,
        "properties": {
          "when": { "$ref": "#/$defs/when" },
          "points": { "type": ["integer", "null"], "minimum": 0, "description": "null は『観測はあるがこの軸の根拠にならない』。軸は null + unknown になる (0 点ではない)。" },
          "basis": { "enum": ["observed", "design"], "description": "この段の裏付け。observed=実測した値がこの段に当たる (実データがある)。design=設計判断で置いた未検証の段。省略不可ではないが、F/G の段には必ず書く (validate が実データと突き合わせる)。" },
          "provenance": { "enum": ["measured", "estimated"], "description": "この段に当たった軸の由来。省略は measured。観測の地点が配信元そのものでないときは estimated (notes を要する)。" },
          "note": { "type": "string", "minLength": 1, "description": "この段の根拠や限界。estimated の段では assessment の notes に写される。" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecolicom/japan-public-data-index/main/schema/family.schema.json",
  "title": "自治体 web 基盤の CMS 系統 (family)",
  "description": "同じ製品なら取得口の形も罠も同じ、という前提で代表実測を群へ展開するための単位。製品名が未特定でも、指紋 (signals) だけで群として成立する。",
  "type": "object",
  "required": ["id", "product", "signals", "sync_kind", "reachability", "measured_representatives"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "family の識別子。製品名が分からない段階では指紋由来の仮 id を振る。製品名が判明しても id は変えず、aliases に足す。",
      "type": "string",
      "pattern": "^fam-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "product": {
      "description": "製品名。未特定は null (空文字は不可)。null は特例ではなく通常の値。",
      "type": ["string", "null"],
      "minLength": 1
    },
    "version": {
      "description": "製品のバージョン。持つなら observed_at と evidence が必須。",
      "type": ["string", "null"],
      "minLength": 1
    },
    "observed_at": { "type": ["string", "null"], "format": "date" },
    "evidence": { "type": ["string", "null"], "minLength": 1 },
    "signals": {
      "description": "HTML 本文または応答ヘッダに現れる痕跡の文字列。scripts/fingerprint.mjs が読む。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "min_signals": {
      "description": "family と判定するのに要る痕跡の本数。省略時は 2。",
      "type": "integer",
      "minimum": 1
    },
    "feed_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "date_field": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sync_kind": { "enum": ["append", "snapshot", "unknown"] },
    "reachability": {
      "type": "object",
      "required": ["overseas_rest"],
      "additionalProperties": false,
      "properties": {
        "overseas_rest": {
          "description": "国外 IP からの到達性。unknown は未観測、not_blocked は観測のうえ遮断なし。",
          "enum": ["unknown", "not_blocked", "blocked", "partial"]
        },
        "observed_from": { "enum": ["jp", "overseas-ci"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "measured_representatives": {
      "description": "この family を実測した自治体の handle。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
    },
    "known_incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["started_at", "ended_at", "summary", "affected", "cause_status"],
        "additionalProperties": false,
        "properties": {
          "started_at": { "type": "string", "format": "date" },
          "ended_at": { "description": "継続中・未確認は null。", "type": ["string", "null"], "format": "date" },
          "summary": { "type": "string", "minLength": 1 },
          "affected": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
          },
          "cause_status": { "enum": ["unconfirmed", "confirmed"] },
          "suspected_factors": {
            "description": "時系列の重なり等で疑われる要因。因果の主張ではない。",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cause_evidence": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "cause_status": { "const": "confirmed" } } },
        "then": { "required": ["cause_evidence"], "properties": { "cause_evidence": true } }
      }
    }
  },
  "if": { "properties": { "version": { "type": "string" } }, "required": ["version"] },
  "then": {
    "required": ["observed_at", "evidence"],
    "properties": {
      "observed_at": { "type": "string" },
      "evidence": { "type": "string" }
    }
  }
}

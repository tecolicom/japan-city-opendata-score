{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecolicom/japan-public-data-index/main/schema/family.schema.json",
  "title": "自治体 web 基盤の CMS 系統 (family)",
  "description": "同じ製品なら取得口の形も罠も同じ、という前提で代表実測を群へ展開するための単位。製品名が未特定でも、指紋 (signals) だけで群として成立する。",
  "type": "object",
  "required": [
    "id",
    "product",
    "signals",
    "sync_kind",
    "reachability",
    "measured_representatives"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "family の識別子。製品名が分からない段階では指紋由来の仮 id を振る。製品名が判明しても id は変えず、aliases に足す。",
      "type": "string",
      "pattern": "^fam-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product": {
      "description": "製品名。未特定は null (空文字は不可)。null は特例ではなく通常の値。",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "version": {
      "description": "製品のバージョン。持つなら observed_at と evidence が必須。",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "signals": {
      "description": "HTML 本文または応答ヘッダに現れる痕跡の文字列。scripts/fingerprint.mjs が読む。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "min_signals": {
      "description": "family と判定するのに要る痕跡の本数。省略時は 2。",
      "type": "integer",
      "minimum": 1
    },
    "feed_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "date_field": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sync_kind": {
      "enum": [
        "append",
        "snapshot",
        "unknown"
      ]
    },
    "reachability": {
      "type": "object",
      "required": [
        "overseas_rest"
      ],
      "additionalProperties": false,
      "properties": {
        "overseas_rest": {
          "description": "国外 IP からの到達性。unknown は未観測、not_blocked は観測のうえ遮断なし。",
          "enum": [
            "unknown",
            "not_blocked",
            "blocked",
            "partial"
          ]
        },
        "observed_from": {
          "enum": [
            "jp",
            "overseas-ci"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "overseas_rest": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "observed_from",
              "observed_at"
            ],
            "properties": {
              "observed_from": true,
              "observed_at": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "overseas_rest": {
                "const": "partial"
              }
            }
          },
          "then": {
            "required": [
              "notes"
            ],
            "properties": {
              "notes": true
            }
          }
        }
      ]
    },
    "measured_representatives": {
      "description": "この family を実測した自治体。どの signal を、いつ、何で、どう確認したか (method) を必ず持つ。signal は signals の部分集合 (scripts/_lib/family-check.mjs で検査)。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "handle",
          "observed_at",
          "evidence",
          "signals_seen"
        ],
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "observed_at": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "backing": {
            "description": "repo 内に裏付け (municipalities/<県>/<handle>/web.yaml) を持たない代表実測だけが宣言する。external = 観測は実在するが記録が repo の外にある。web.yaml が無いのに backing が無ければ validate は落ちる。",
            "enum": ["external"]
          },
          "backing_note": {
            "description": "backing: external の根拠と観測日。backing とセットで必須。",
            "type": "string",
            "minLength": 1
          },
          "signals_seen": {
            "description": "その自治体で確認した signal。method で観測 (html/header/asset_fetch) と推定 (inferred_from_status) を区別する。",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "signal",
                "method"
              ],
              "additionalProperties": false,
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "html",
                    "header",
                    "asset_fetch",
                    "inferred_from_status"
                  ],
                  "description": "html=トップページ HTML に現れた / header=応答ヘッダに現れた / asset_fetch=HTML には現れず、資産ファイル (JS 等) を直接取得して存在を確認した (直接観測) / inferred_from_status=HTML には無く、応答状態 (502 等) から存在を推定"
                }
              }
            }
          }
        }
      }
    },
    "known_incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ended_at",
          "summary",
          "affected",
          "cause_status",
          "start_window"
        ],
        "additionalProperties": false,
        "properties": {
          "ended_at": {
            "description": "継続中・未確認は null。",
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "affected": {
            "description": "2026-10-23 等の確認日時点で影響を受けていた自治体。確認日と根拠を持つ。開始時刻が同時だったとは限らない (start_window で区別)。",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "handle",
                "observed_at",
                "evidence",
                "start_window"
              ],
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "start_window": {
                  "description": "この自治体の開始窓。観測していなければ null。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "after",
                        "before",
                        "evidence"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "after": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "before": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "cause_status": {
            "enum": [
              "unconfirmed",
              "confirmed"
            ]
          },
          "suspected_factors": {
            "description": "時系列の重なり等で疑われる要因。因果の主張ではない。出典を必ず持つ。",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "summary",
                "sources"
              ],
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "url",
                      "confirmed_at"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "confirmed_at": {
                        "type": "string",
                        "format": "date"
                      },
                      "advisory": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "cause_evidence": {
            "type": "string",
            "minLength": 1
          },
          "cause_search": {
            "description": "原因の公表を探した範囲。不在の主張は範囲と日付を限定して書く。",
            "type": "object",
            "required": [
              "searched_at",
              "scope",
              "result"
            ],
            "additionalProperties": false,
            "properties": {
              "searched_at": {
                "type": "string",
                "format": "date"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "start_window": {
            "description": "停止が始まった窓。直前の正常確認 (after) と最初の異常確認 (before)。実際に観測した自治体 1 件についてのみ書く。",
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "handle",
                  "after",
                  "before",
                  "evidence"
                ],
                "additionalProperties": false,
                "properties": {
                  "handle": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  },
                  "after": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "before": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "if": {
          "properties": {
            "cause_status": {
              "const": "confirmed"
            }
          }
        },
        "then": {
          "required": [
            "cause_evidence"
          ],
          "properties": {
            "cause_evidence": true
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "version": {
        "type": "string"
      }
    },
    "required": [
      "version"
    ]
  },
  "then": {
    "required": [
      "observed_at",
      "evidence"
    ],
    "properties": {
      "observed_at": {
        "type": "string"
      },
      "evidence": {
        "type": "string"
      }
    }
  }
}

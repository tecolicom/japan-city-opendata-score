{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecolicom/japan-city-data-usability/main/schema/domains.schema.json",
  "title": "情報領域の語彙",
  "type": "object",
  "required": ["domains"],
  "additionalProperties": false,
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name_ja", "standard_dataset", "profile"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "name_ja": { "type": "string", "minLength": 1 },
          "standard_dataset": {
            "type": ["string", "null"],
            "pattern": "^自治体標準オープンデータセット/(基本編/[0-9]+|応用編/[AB]-[0-9]+)_.+$"
          },
          "profile": { "enum": ["static", "dynamic", null] },
          "publishers_expected": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "if": { "properties": { "profile": { "type": "null" } } },
        "then": { "properties": { "publishers_expected": false } },
        "else": { "required": ["publishers_expected"] }
      }
    }
  }
}
